# Scam Shield Environment Variables (Template for local developers)
# For local development: copy this file to '.env' and configure your values.
# For deployed Streamlit apps: configure secrets in Streamlit Cloud Secrets.
# NEVER commit your actual .env file or real API keys to version control.

GEMINI_API_KEY="your_gemini_api_key_here"

# Path to the curated dataset directory containing dataset.csv, sources.csv, etc.
# If not specified, Scam Shield will look in the default Windows Downloads path
# or in the local ./data directory.
SCAM_SHIELD_DATASET_DIR="C:/Users/adira/Downloads/scam-shield-dataset/scam_shield_curation"
