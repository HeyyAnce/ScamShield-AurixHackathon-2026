# Local configuration. Copy to .env and keep real keys out of Git.
# On Streamlit Community Cloud, set GEMINI_API_KEY in Secrets instead.
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: a directory containing messages_english.csv and messages_hinglish.csv.
# Relative paths resolve from the project root. Omit to use bundled data/dataset.
# Missing/incomplete override folders fall back to the bundled message files.
# SCAM_SHIELD_DATASET_DIR="data/dataset"
